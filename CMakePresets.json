		{
			"name": "WIN-X64-DEBUG",
			"displayName": "Windows x64 Debug",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/out/build/WIN-X64-DEBUG",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/WIN-X64-DEBUG",
				"CMAKE_POLICY_VERSION_MINIMUM": "3.23"
			},
			"vendor": {
				"visualstudio": {
					"environment": "msvc_x64_x64"
				}
			}
		},
		{
			"name": "WIN-X64-DEBUG-SERVER",
			"displayName": "Windows x64 Debug (Server-Client Mode)",
